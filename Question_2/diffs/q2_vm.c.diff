@@ -392,3 +392,33 @@
 //PAGEBREAK!
 // Blank page.
 
+
+// Asg9 Q2: fault in one lazy heap page for the current process.
+// Returns 0 on success, -1 if invalid.
+int
+lazyalloc(uint va)
+{
+  struct proc *cur = myproc();
+  pte_t *pte;
+  char *mem;
+
+  if(cur == 0 || va >= cur->sz)
+    return -1;
+  pte = walkpgdir(cur->pgdir, (void*)va, 0);
+  if(pte && (*pte & PTE_P)){
+    if(*pte & PTE_U)
+      return 0;            // already there
+    return -1;             // guard page
+  }
+  mem = kalloc();
+  if(mem == 0)
+    return -1;
+  memset(mem, 0, PGSIZE);
+  if(mappages(cur->pgdir, (char*)PGROUNDDOWN(va), PGSIZE,
+              V2P(mem), PTE_W|PTE_U) < 0){
+    kfree(mem);
+    return -1;
+  }
+  cur->nfaults++;
+  return 0;
+}
